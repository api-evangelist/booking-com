            "url": "https://demandapi.booking.com/3.1/properties/:property_id/rooms",
            "params": [
              {
                "name": "property_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the property on Booking.com"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
